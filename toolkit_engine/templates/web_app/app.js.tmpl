// Small browser module for the app shell. Generated by toolkit_engine {{ foundation_version }}. Managed file.
// Plain JavaScript on purpose: browsers cannot run TypeScript, and this starter has no build step.
const chips = Array.from(document.querySelectorAll('#chips .chip'));
const status = document.getElementById('status');

function selected() {
  const chip = chips.find((item) => item.getAttribute('aria-pressed') === 'true');
  return chip ? chip.textContent.trim() : null;
}

function say(message) {
  status.textContent = message;
}

for (const chip of chips) {
  chip.addEventListener('click', () => {
    for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
    say('Scope: ' + chip.textContent.trim() + '.');
  });
}

document.getElementById('run').addEventListener('click', () => {
  const scope = selected();
  say(scope ? 'Checked ' + scope + ' at ' + new Date().toLocaleTimeString() + '. Nothing was changed.' : 'Pick a scope first.');
});

document.getElementById('reset').addEventListener('click', () => {
  chips.forEach((chip, index) => chip.setAttribute('aria-pressed', String(index === 0)));
  say('Pick a scope, then run the check.');
});
