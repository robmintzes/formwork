<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generated by toolkit_engine {{ foundation_version }}. Managed file: regenerate instead of editing.
    Build:  dotnet build {{ project_file }} -c Release -p:RevitVersion=2026
    No NuGet packages are referenced, so restore works offline. The Revit API is
    referenced from the installed product (RevitInstallDir) and never copied to the output.
  -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitInstallDir>
    <RevitInstallDir Condition="!HasTrailingSlash('$(RevitInstallDir)')">$(RevitInstallDir)\</RevitInstallDir>
  </PropertyGroup>

  <!--
    Target framework follows the runtime the installed Revit hosts:
      Revit 2027                                          -> net10.0-windows
      Revit 2025.5 / 2026.5 and later (Autodesk moved both to .NET 10) -> net10.0-windows
      Revit 2025 / 2026 before those updates              -> net8.0-windows
    For 2025 and 2026 the project reads the installed product's AdApplicationFrame.runtimeconfig.json to tell
    the two apart. Override with -p:RevitTargetFramework=net8.0-windows or net10.0-windows. An add-in built for
    .NET 10 does not load in a .NET 8 host, and the other way round. Revit 2024 (.NET Framework 4.8) is out of scope.
  -->
  <PropertyGroup Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026' Or '$(RevitVersion)' == '2027'">
    <RevitVersionSupported>true</RevitVersionSupported>
    <RevitHostRuntimeConfig>$(RevitInstallDir)AdApplicationFrame.runtimeconfig.json</RevitHostRuntimeConfig>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersionSupported)' == 'true' And '$(RevitTargetFramework)' == '' And '$(RevitVersion)' == '2027'">
    <RevitTargetFramework>net10.0-windows</RevitTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersionSupported)' == 'true' And '$(RevitTargetFramework)' == '' And Exists('$(RevitHostRuntimeConfig)') And $([System.IO.File]::ReadAllText('$(RevitHostRuntimeConfig)').Contains('net10.0'))">
    <RevitTargetFramework>net10.0-windows</RevitTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersionSupported)' == 'true' And '$(RevitTargetFramework)' == ''">
    <RevitTargetFramework>net8.0-windows</RevitTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitTargetFramework)' == 'net8.0-windows' Or '$(RevitTargetFramework)' == 'net10.0-windows'">
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == ''">
    <!-- Keeps evaluation valid so the TKADDIN001 / TKADDIN003 message below is what the user sees. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RevitTargetFrameworkInvalid>true</RevitTargetFrameworkInvalid>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>{{ assembly }}</AssemblyName>
    <RootNamespace>{{ root_namespace }}</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NuGetAudit>false</NuGetAudit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <!-- The XAML dictionaries are embedded as text and parsed at run time; nothing is markup-compiled. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!-- Assembly name and version are stable; display strings below follow the firm identity. -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>{{ product }}</Product>
    <Company>{{ company }}</Company>
    <Description>{{ description }}</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Theme.xaml" LogicalName="Resources.Theme.xaml" />
    <EmbeddedResource Include="Resources\Controls.xaml" LogicalName="Resources.Controls.xaml" />
    <EmbeddedResource Include="Resources\SummaryWindow.xaml" LogicalName="Resources.SummaryWindow.xaml" />
    <EmbeddedResource Include="Resources\symbol-light.png" LogicalName="Resources.symbol-light.png" />
    <EmbeddedResource Include="Resources\symbol-inverse.png" LogicalName="Resources.symbol-inverse.png" />
    <EmbeddedResource Include="Resources\icon-32.png" LogicalName="Resources.icon-32.png" />
    <EmbeddedResource Include="Resources\icon-16.png" LogicalName="Resources.icon-16.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packaged fonts (and their licences) sit beside the DLL; Theme.xaml names them by relative URI. -->
    <None Include="fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="{{ assembly }}.addin;README.md;.gitignore" />
  </ItemGroup>

  <Target Name="ToolkitCheckRevitVersion" BeforeTargets="Restore;_CheckForInvalidConfigurationAndPlatform" Condition="'$(RevitVersionSupported)' != 'true' Or '$(RevitTargetFrameworkInvalid)' == 'true'">
    <Error Condition="'$(RevitVersionSupported)' != 'true'" Code="TKADDIN001" Text="RevitVersion '$(RevitVersion)' is not supported by this starter. Supported: 2025, 2026 and 2027. Revit 2024 hosts .NET Framework 4.8 and is not covered." />
    <Error Condition="'$(RevitVersionSupported)' == 'true'" Code="TKADDIN003" Text="RevitTargetFramework '$(RevitTargetFramework)' is not supported. Use net8.0-windows or net10.0-windows." />
  </Target>

  <Target Name="ToolkitCheckRevitApi" BeforeTargets="BeforeResolveReferences" Condition="'$(RevitVersionSupported)' == 'true' And !Exists('$(RevitInstallDir)RevitAPI.dll')">
    <Error Code="TKADDIN002" Text="RevitAPI.dll was not found in '$(RevitInstallDir)'. Install Revit $(RevitVersion) or pass -p:RevitInstallDir=&quot;D:\path\to\Revit $(RevitVersion)\&quot;." />
  </Target>

</Project>
