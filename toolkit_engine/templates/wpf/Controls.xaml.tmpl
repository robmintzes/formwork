<!--
  Generated by toolkit_engine {{ foundation_version }}. Managed file.
  Styles consume Theme.xaml keys through DynamicResource; shape and stroke
  values are resolved from firm appearance choices at generation time.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="{{ ns }}.Text.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {{ font_display }}}"/>
    <Setter Property="FontSize" Value="{DynamicResource {{ size_display }}}"/>
    <Setter Property="FontWeight" Value="{DynamicResource {{ weight_display }}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {{ text_primary }}}"/>
  </Style>
  <Style x:Key="{{ ns }}.Text.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {{ font_display }}}"/>
    <Setter Property="FontSize" Value="{DynamicResource {{ size_title }}}"/>
    <Setter Property="FontWeight" Value="{DynamicResource {{ weight_display }}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {{ text_primary }}}"/>
  </Style>
  <Style x:Key="{{ ns }}.Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {{ font_body }}}"/>
    <Setter Property="FontSize" Value="{DynamicResource {{ size_body }}}"/>
    <Setter Property="FontWeight" Value="{DynamicResource {{ weight_body }}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {{ text_primary }}}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="{{ ns }}.Text.Small" TargetType="TextBlock" BasedOn="{StaticResource {{ ns }}.Text.Body}">
    <Setter Property="FontSize" Value="{DynamicResource {{ size_small }}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {{ text_secondary }}}"/>
  </Style>
  <Style x:Key="{{ ns }}.Text.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {{ font_label }}}"/>
    <Setter Property="FontSize" Value="{DynamicResource {{ size_label }}}"/>
    <Setter Property="FontWeight" Value="{DynamicResource {{ weight_label }}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {{ text_secondary }}}"/>
    <Setter Property="Margin" Value="0,0,0,{{ space_sm }}"/>
  </Style>
  <Style x:Key="{{ ns }}.Text.Code" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {{ font_code }}}"/>
    <Setter Property="FontSize" Value="{DynamicResource {{ size_code }}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {{ text_primary }}}"/>
  </Style>

  <ControlTemplate x:Key="{{ ns }}.Button.Template" TargetType="Button">
    <Grid x:Name="Root">
      <Border x:Name="FocusRing" Margin="{{ ring_margin }}" CornerRadius="{{ ring_radius }}"
              BorderThickness="{{ focus_stroke }}" BorderBrush="{DynamicResource {{ focus_ring }}}"
              Visibility="Collapsed"/>
      <Border x:Name="Chrome" CornerRadius="{{ button_radius }}"
              Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.76"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="{{ ns }}.Button.Base" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template" Value="{StaticResource {{ ns }}.Button.Template}"/>
    <Setter Property="FontFamily" Value="{DynamicResource {{ font_body }}}"/>
    <Setter Property="FontSize" Value="{DynamicResource {{ size_body }}}"/>
    <Setter Property="FontWeight" Value="{DynamicResource {{ weight_strong }}}"/>
    <Setter Property="MinHeight" Value="{{ control_height }}"/>
    <Setter Property="Padding" Value="{{ space_md }},0"/>
    <Setter Property="Margin" Value="0,0,{{ space_md }},0"/>
    <Setter Property="BorderThickness" Value="{{ control_stroke }}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="{{ ns }}.Button.Primary" TargetType="Button" BasedOn="{StaticResource {{ ns }}.Button.Base}">
    <Setter Property="Background" Value="{{ primary_bg }}"/>
    <Setter Property="Foreground" Value="{{ primary_fg }}"/>
    <Setter Property="BorderBrush" Value="{{ primary_border }}"/>
  </Style>
  <Style x:Key="{{ ns }}.Button.Secondary" TargetType="Button" BasedOn="{StaticResource {{ ns }}.Button.Base}">
    <Setter Property="Background" Value="{{ secondary_bg }}"/>
    <Setter Property="Foreground" Value="{{ secondary_fg }}"/>
    <Setter Property="BorderBrush" Value="{{ secondary_border }}"/>
  </Style>

  <Style x:Key="{{ ns }}.Chip" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontFamily" Value="{DynamicResource {{ font_body }}}"/>
    <Setter Property="FontSize" Value="{DynamicResource {{ size_small }}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {{ text_primary }}}"/>
    <Setter Property="Background" Value="{DynamicResource {{ surface_card }}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {{ line_strong }}}"/>
    <Setter Property="BorderThickness" Value="{{ control_stroke }}"/>
    <Setter Property="Padding" Value="{{ space_md }},4"/>
    <Setter Property="Margin" Value="0,0,{{ space_sm }},0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" CornerRadius="{{ chip_radius }}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {{ accent_soft }}}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {{ accent_default }}}"/>
              <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
              <Setter Property="FontWeight" Value="{DynamicResource {{ weight_strong }}}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {{ focus_ring }}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{{ ns }}.ListItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontFamily" Value="{DynamicResource {{ font_body }}}"/>
    <Setter Property="FontSize" Value="{DynamicResource {{ size_small }}}"/>
    <Setter Property="Foreground" Value="{DynamicResource {{ text_primary }}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="{{ space_sm }},6">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource {{ accent_soft }}}"/>
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource {{ accent_default }}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{{ ns }}.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource {{ surface_card }}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {{ line_subtle }}}"/>
    <Setter Property="BorderThickness" Value="{{ control_stroke }}"/>
    <Setter Property="Padding" Value="{{ space_md }}"/>
    <Setter Property="Margin" Value="0,0,0,{{ space_md }}"/>
  </Style>

{{ badge_styles }}
</ResourceDictionary>
