"""Command line: turn a CSV or JSON table into a branded, offline HTML report.

Generated by toolkit_engine {{ foundation_version }}. Managed file.
"""

from __future__ import annotations

import argparse
from pathlib import Path
import sys
from typing import Sequence

from . import __version__
from .render import ReportError, load_table, render_report, write_report


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="{{ package }}",
        description="Turn a CSV or JSON table into a branded, offline HTML report.",
    )
    parser.add_argument("--version", action="version", version="%(prog)s " + __version__)
    commands = parser.add_subparsers(dest="command", required=True)
    report = commands.add_parser("report", help="render INPUT (.csv or .json) as one HTML file")
    report.add_argument("input", metavar="INPUT", type=Path, help="CSV file, or JSON file holding a list of objects")
    report.add_argument("--output", "-o", required=True, type=Path, metavar="OUT.html", help="HTML file to write")
    report.add_argument("--title", help="report title (default: the input file name)")
    report.add_argument(
        "--status-column",
        metavar="C",
        help="column whose values become status pills (default: a column named Status, if present)",
    )
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        table = load_table(args.input)
        title = args.title or args.input.stem.replace("_", " ").replace("-", " ")
        document = render_report(
            table,
            title=title,
            source_name=args.input.name,
            status_column=args.status_column,
            output_dir=args.output.parent,
        )
        write_report(args.output, document)
    except ReportError as exc:
        print("error: {}".format(exc), file=sys.stderr)
        return 2
    print("wrote {} ({} rows, {} columns)".format(args.output, len(table.rows), len(table.columns)))
    return 0
