# Generated by toolkit_engine {{ foundation_version }}. Managed file: regenerate the workspace instead of editing it.
[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = {{ name }}
version = "0.1.0"
description = {{ description }}
readme = "README.md"
requires-python = ">=3.10"
dependencies = []

[project.scripts]
{{ name_bare }} = "{{ package }}.cli:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
{{ package }} = ["theme.css", "assets/*.svg"]
