"""Tests for the report generator (generated by toolkit_engine {{ foundation_version }}).

Run from the app folder: ``PYTHONPATH=src python -m unittest discover -s tests``.
"""

from __future__ import annotations

import contextlib
import html
import io
import json
from pathlib import Path
import re
import tempfile
import unittest

from {{ package }} import branding, cli
from {{ package }}.render import (
    ReportError,
    Table,
    load_table,
    render_report,
    status_tone,
    table_from_csv,
    table_from_json,
)

APP = Path(__file__).resolve().parents[1]
SAMPLE = APP / "sample.csv"
EXTERNAL_LOAD = re.compile(
    r"""<(?:img|script|link|iframe|source|video|audio|embed|object)\b[^>]*\b(?:src|href|data)\s*=\s*["']?\s*(?:https?:)?//"""
    r"""|url\(\s*["']?\s*(?:https?:)?//|@import\b""",
    re.IGNORECASE,
)


class ReportTests(unittest.TestCase):
    def test_sample_renders_a_branded_report(self) -> None:
        page = render_report(load_table(SAMPLE), title="Sheet index", source_name="sample.csv")
        self.assertTrue(page.startswith("<!doctype html>"))
        self.assertIn(html.escape(branding.DISPLAY_NAME, quote=True), page)
        self.assertIn('class="metric__value">8<', page)  # rows
        self.assertIn('class="metric__value">6<', page)  # columns
        theme = (APP / "src" / "{{ package }}" / "theme.css").read_text(encoding="utf-8")
        self.assertIn(theme.replace("</", "<\\/"), page)  # the whole stylesheet is embedded
        self.assertIn(html.escape(branding.SUPPORT_URL, quote=True), page)

    def test_cells_titles_and_headers_are_escaped(self) -> None:
        table = Table(["<b>Name</b>", "Status"], [["<script>alert(1)</script>", "Issued"], ['"quoted" & more', "x"]])
        page = render_report(table, title="<img src=x onerror=alert(1)>")
        self.assertNotIn("<script>alert(1)</script>", page)
        self.assertIn("&lt;script&gt;alert(1)&lt;/script&gt;", page)
        self.assertIn("&lt;b&gt;Name&lt;/b&gt;", page)
        self.assertNotIn("<img src=x", page)
        self.assertIn("&quot;quoted&quot; &amp; more", page)
        self.assertNotIn("<script", page.lower())

    def test_output_loads_nothing_from_a_network(self) -> None:
        page = render_report(load_table(SAMPLE), title="Sheet index")
        self.assertIsNone(EXTERNAL_LOAD.search(page))
        self.assertIn("data:image/svg+xml;base64,", page)

    def test_status_pills_follow_the_status_column(self) -> None:
        page = render_report(load_table(SAMPLE), title="Sheet index")
        self.assertIn('<span class="badge badge--success">Issued</span>', page)
        self.assertIn('<span class="badge badge--warning">In review</span>', page)
        self.assertIn('<span class="badge badge--danger">Blocked</span>', page)
        self.assertIn('<span class="badge badge--info">Superseded</span>', page)
        self.assertEqual(status_tone(" ISSUED "), "success")
        self.assertEqual(status_tone("Mystery"), "info")

    def test_status_column_can_be_chosen_and_must_exist(self) -> None:
        table = Table(["Item", "State"], [["a", "Failed"], ["b", "Done"]])
        page = render_report(table, title="T", status_column="State")
        self.assertIn("badge--danger", page)
        self.assertIn("badge--success", page)
        self.assertNotIn("badge--", render_report(table, title="T").split("<tbody>")[1])
        with self.assertRaises(ReportError):
            render_report(table, title="T", status_column="Nope")

    def test_json_input_matches_csv_input(self) -> None:
        rows = [{"Sheet": "A-1", "Title": "Plan", "Status": "Issued"}, {"Sheet": "A-2", "Status": None}]
        table = table_from_json(json.dumps({"rows": rows}))
        self.assertEqual(table.columns, ["Sheet", "Title", "Status"])
        self.assertEqual(table.rows[1], ["A-2", "", ""])
        self.assertEqual(table_from_csv("Sheet,Title\nA-1,Plan\n").rows, [["A-1", "Plan"]])
        with self.assertRaises(ReportError):
            table_from_json("[1, 2]")
        with self.assertRaises(ReportError):
            table_from_csv("a,b\n1,2,3\n")

    def test_command_line_writes_the_report_and_reports_errors(self) -> None:
        with tempfile.TemporaryDirectory() as folder:
            out = Path(folder) / "nested" / "report.html"
            with contextlib.redirect_stdout(io.StringIO()):
                code = cli.main(["report", str(SAMPLE), "--output", str(out), "--title", "Sheets"])
            self.assertEqual(code, 0)
            self.assertIn("<h1>Sheets</h1>", out.read_text(encoding="utf-8"))
            with contextlib.redirect_stderr(io.StringIO()) as err:
                code = cli.main(["report", str(SAMPLE), "--output", str(out), "--status-column", "Nope"])
            self.assertEqual(code, 2)
            self.assertIn("no column named", err.getvalue())
            with contextlib.redirect_stderr(io.StringIO()):
                self.assertEqual(cli.main(["report", str(Path(folder) / "missing.csv"), "--output", str(out)]), 2)


if __name__ == "__main__":
    unittest.main()
