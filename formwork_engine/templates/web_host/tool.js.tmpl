// Page logic for the demo tool. Generated by formwork_engine {{ foundation_version }}. Managed file.
//
// Read-only: it asks the host for view counts (init_data), shows them, filters them
// on the client and copies a text summary with the browser clipboard API. Nothing
// here asks the host to change the model.
(function () {
  "use strict";

  var bridge = window.{{ ns }};
  var ui = window.{{ ns }}ui;
  var TITLE = "{{ title }}";
  var STATE_TEXT = {
    idle: "Ready",
    waiting: "Reading",
    partial: "Done, with warnings",
    failure: "Failed",
    canceled: "Canceled",
    done: "Done"
  };

  var rows = [];
  var project = "";
  var skipped = 0;
  var action = null;

  function byId(id) { return document.getElementById(id); }

  function log(line) {
    var el = byId("log");
    el.textContent += (el.textContent ? "\n" : "") + line;
    el.scrollTop = el.scrollHeight;
  }

  function setState(state, message) {
    ui.setState(state, message);
    byId("state-label").textContent = STATE_TEXT[state] || state;
  }

  function showError(message) {
    var el = byId("error");
    el.textContent = message;
    el.hidden = false;
  }

  function clearError() {
    var el = byId("error");
    el.textContent = "";
    el.hidden = true;
  }

  // Which pill a row gets, from its own numbers.
  function coverage(row) {
    if (row.templates === 0) return { cls: "badge--warning", text: "No template" };
    if (row.views === 0) return { cls: "badge--info", text: "Templates only" };
    return { cls: "badge--success", text: "Has template" };
  }

  function renderMetrics() {
    var views = 0, templates = 0, gaps = 0;
    rows.forEach(function (row) {
      views += row.views;
      templates += row.templates;
      if (row.views > 0 && row.templates === 0) gaps += 1;
    });
    byId("metric-views").textContent = String(views);
    byId("metric-templates").textContent = String(templates);
    byId("metric-types").textContent = String(rows.length);
    byId("metric-gaps").textContent = String(gaps);
  }

  function cell(text, className) {
    var td = document.createElement("td");
    td.textContent = text;
    td.title = text;
    if (className) td.className = className;
    return td;
  }

  function renderRows() {
    var body = byId("counts-body");
    body.textContent = "";
    rows.forEach(function (row) {
      var tr = document.createElement("tr");
      tr.setAttribute("data-label", row.label.toLowerCase());
      tr.appendChild(cell(row.label));
      tr.appendChild(cell(String(row.views), "c-num"));
      tr.appendChild(cell(String(row.templates), "c-num"));
      var pill = coverage(row);
      var td = document.createElement("td");
      var badge = document.createElement("span");
      badge.className = "badge " + pill.cls;
      badge.textContent = pill.text;
      td.appendChild(badge);
      tr.appendChild(td);
      body.appendChild(tr);
    });
    applyFilter();
  }

  function applyFilter() {
    var needle = byId("filter").value.trim().toLowerCase();
    var shown = 0;
    Array.prototype.forEach.call(byId("counts-body").children, function (tr) {
      var match = !needle || tr.getAttribute("data-label").indexOf(needle) !== -1;
      tr.hidden = !match;
      if (match) shown += 1;
    });
    byId("empty").hidden = shown > 0 || rows.length === 0;
    if (rows.length) {
      byId("summary-line").textContent = shown + " of " + rows.length + " view types" +
        (project ? " in " + project : "");
    }
  }

  function summaryText() {
    var lines = [TITLE + (project ? " - " + project : "")];
    lines.push("Views: " + byId("metric-views").textContent +
      " | Templates: " + byId("metric-templates").textContent +
      " | View types: " + byId("metric-types").textContent +
      " | Types without a template: " + byId("metric-gaps").textContent);
    rows.forEach(function (row) {
      lines.push(row.label + ": " + row.views + " views, " + row.templates + " templates");
    });
    return lines.join("\n");
  }

  function setBusy(busy) {
    byId("btn-refresh").disabled = busy;
    byId("btn-copy").disabled = busy || rows.length === 0;
  }

  function load() {
    clearError();
    setBusy(true);
    setState("waiting", "Reading the model");
    ui.setProgress(0, 1, "Reading views");
    log("Reading the model (read-only).");
    return bridge.call("init_data").then(function (data) {
      rows = data.rows || [];
      project = data.project || "";
      skipped = data.skipped || 0;
      renderMetrics();
      renderRows();
      ui.setProgress(1, 1, "Read " + data.total_views + " views");
      log("Read " + data.total_views + " views in " + rows.length + " view types.");
      if (skipped) {
        log("Skipped " + skipped + " view(s) that could not be read.");
        setState("partial", "Done with " + skipped + " skipped");
      } else {
        setState("done", "Finished reading the model");
        action.markRun({ status: "success" });
      }
      if (!rows.length) byId("summary-line").textContent = "This document has no views to count.";
    }).catch(function (error) {
      setState("failure", "Could not read the model");
      showError(error.message || String(error));
      log("FAILED: " + (error.message || String(error)));
      byId("summary-line").textContent = "Not available";
    }).then(function () {
      setBusy(false);
    });
  }

  function copySummary() {
    var button = byId("btn-copy");
    ui.copyText(summaryText()).then(function (ok) {
      ui.flashLabel(button, ok ? "Copied" : "Copy failed");
      log(ok ? "Summary copied to the clipboard." : "The clipboard was not available.");
    });
  }

  function start() {
    action = ui.primaryAction(byId("btn-refresh"), { verb: "Read model", object: "counts", usage: "reusable" });
    byId("filter").addEventListener("input", applyFilter);
    byId("btn-refresh").addEventListener("click", load);
    byId("btn-copy").addEventListener("click", copySummary);
    byId("btn-close").addEventListener("click", function () {
      if (bridge.hosted) bridge.close();
    });
    if (!bridge.hosted) {
      setState("failure", "Not running in Revit");
      showError("This page runs inside Revit. Open it from the ribbon button.");
      byId("summary-line").textContent = "Not available";
      setBusy(false);
      byId("btn-refresh").disabled = true;
      return;
    }
    load();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
})();
