// tool-ui.js - small helpers for tool pages: lifecycle state, progress, copy to
// clipboard, a countdown button and the primary-action morph.
// Generated by formwork_engine {{ foundation_version }}. Managed file: regenerate, do not edit.
//
// No framework, no network. Everything that styles the page lives in tool.css;
// this file only sets attributes and text. It never writes markup from data.
//
// Lifecycle state is the data-state attribute on <body>:
//   idle | waiting | partial | failure | canceled | done
// tool.css reads it, so a tool changes behavior by calling setState and not by
// adding rules of its own.
(function () {
  "use strict";

  var STATES = ["idle", "waiting", "partial", "failure", "canceled", "done"];
  var live = null;

  function liveRegion() {
    if (live) return live;
    live = document.createElement("div");
    live.className = "sr-only";
    live.setAttribute("aria-live", "polite");
    live.setAttribute("role", "status");
    document.body.appendChild(live);
    return live;
  }

  function announce(text) {
    if (text) liveRegion().textContent = text;
  }

  function setState(state, announceText) {
    if (STATES.indexOf(state) === -1) {
      console.error("tool-ui: unknown state", state);
      return;
    }
    document.body.setAttribute("data-state", state);
    announce(announceText);
  }

  // <progress class="progress" data-progress> plus an optional <span data-progress-label>.
  function setProgress(done, total, label) {
    var bar = document.querySelector("progress[data-progress]");
    if (bar && total > 0) {
      bar.max = total;
      bar.value = done;
    }
    var text = document.querySelector("[data-progress-label]");
    if (text) text.textContent = label || (done + " / " + total);
    announce(label);
  }

  // Resolves true when the text reached the clipboard. The asynchronous
  // Clipboard API needs a secure context and a user gesture; the fallback uses a
  // hidden textarea and the legacy copy command.
  function copyText(text) {
    function legacy() {
      var area = document.createElement("textarea");
      area.className = "sr-only";
      area.value = text;
      document.body.appendChild(area);
      area.select();
      var ok = false;
      try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
      document.body.removeChild(area);
      return ok;
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(text).then(
        function () { return true; },
        function () { return legacy(); }
      );
    }
    return Promise.resolve(legacy());
  }

  // Briefly replaces a button's label, then restores it.
  function flashLabel(button, text) {
    var previous = button.getAttribute("data-label") || button.textContent;
    button.setAttribute("data-label", previous);
    button.textContent = text;
    setTimeout(function () { button.textContent = previous; }, 1400);
  }

  // <button data-copy="#log">Copy log</button> copies the text of #log.
  function wireCopyButtons(root) {
    (root || document).querySelectorAll("[data-copy]").forEach(function (button) {
      button.addEventListener("click", function () {
        var source = document.querySelector(button.getAttribute("data-copy"));
        if (!source) return;
        copyText(source.textContent).then(function (ok) {
          flashLabel(button, ok ? "Copied" : "Copy failed");
        });
      });
    });
  }

  // <button data-countdown="30" data-countdown-text="Close ({s})">Close</button>
  // Calls onExpire at zero (default: close the tool). Any interaction stops it and
  // restores the label.
  function startCountdown(button, onExpire) {
    var seconds = parseInt(button.getAttribute("data-countdown"), 10);
    if (isNaN(seconds) || seconds < 0) {
      console.error("tool-ui: bad data-countdown");
      return;
    }
    var template = button.getAttribute("data-countdown-text") || "Close ({s})";
    var base = button.textContent;
    var timer = null;
    function stop() {
      clearTimeout(timer);
      button.textContent = base;
    }
    function tick() {
      button.textContent = template.replace("{s}", seconds);
      if (seconds-- <= 0) {
        var close = onExpire || (window.{{ ns }} && window.{{ ns }}.close);
        if (close) close();
        return;
      }
      timer = setTimeout(tick, 1000);
    }
    button.addEventListener("click", function () { clearTimeout(timer); });
    ["keydown", "pointerdown"].forEach(function (name) {
      document.addEventListener(name, stop, { once: true });
    });
    tick();
  }

  var USAGE = {
    reusable: { label: "Reusable", title: "Run it again to adjust. Changes update in place." },
    setup: { label: "Setup", title: "Run once when setting up a project." },
    "one-time": { label: "One-time", title: "Makes a single change, then closes." }
  };

  // <span class="usage" data-usage="reusable"></span> in the tool header.
  function initUsageBadges(root) {
    (root || document).querySelectorAll(".usage[data-usage]").forEach(function (badge) {
      var entry = USAGE[badge.getAttribute("data-usage")];
      if (!entry) throw new Error("Unknown usage mode: " + badge.getAttribute("data-usage"));
      badge.title = entry.title;
      badge.textContent = entry.label;
    });
  }

  // The primary button's verb follows the tool's usage mode (read from the header
  // badge). A reusable tool becomes "Update <object>" after a successful run and
  // stays open; any other tool turns into a "Done" button that counts down.
  //   var action = ui.primaryAction(button, { verb: "Run audit", object: "audit" });
  //   action.markRun(result);   // result.status === "success"
  function primaryAction(button, options) {
    options = options || {};
    var badge = document.querySelector(".tool-header .usage[data-usage]");
    var usage = badge && badge.getAttribute("data-usage");
    if (!USAGE[usage] || (options.usage && options.usage !== usage)) {
      throw new Error("Primary action usage does not match the header");
    }
    button.textContent = options.verb;
    var ran = false;
    return {
      markRun: function (result) {
        if (!result || result.status !== "success") return;
        if (usage === "reusable") {
          ran = true;
          button.textContent = "Update " + options.object;
        } else {
          button.classList.remove("btn--primary");
          button.classList.add("btn--success");
          button.textContent = "Done";
          if (!button.getAttribute("data-countdown")) {
            button.setAttribute("data-countdown", String(options.countdown || 5));
          }
          startCountdown(button, options.onExpire);
        }
      },
      hasRun: function () { return ran; }
    };
  }

  window.{{ ns }}ui = {
    STATES: STATES,
    setState: setState,
    setProgress: setProgress,
    announce: announce,
    copyText: copyText,
    flashLabel: flashLabel,
    wireCopyButtons: wireCopyButtons,
    startCountdown: startCountdown,
    initUsageBadges: initUsageBadges,
    primaryAction: primaryAction
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function () { initUsageBadges(); }, { once: true });
  } else {
    initUsageBadges();
  }
})();
