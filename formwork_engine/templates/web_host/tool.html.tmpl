<!doctype html>
<!-- Generated by formwork_engine {{ foundation_version }}. Managed file: regenerate, do not edit.
     Served at https://{{ tool_host }}/tool.html by the web host. Strict policy: no inline
     script or style, and nothing loads from outside the two virtual hosts. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' https://{{ assets_host }} https://{{ tool_host }}; base-uri 'none'; object-src 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="stylesheet" href="https://{{ assets_host }}/tool.css">
</head>
<body class="tool" data-state="idle">
  <header class="tool-header">
    <h1 class="tool-header__title">{{ title }}</h1>
    <span class="tool-header__state" id="state-label">Ready</span>
    <div class="tool-header__end">
      <span class="usage" data-usage="reusable"></span>
      <img class="tool-header__mark" src="https://{{ assets_host }}/symbol-light.svg" alt="{{ logo_alt }}">
    </div>
  </header>

  <div class="tool__body" role="main">
    <p class="eyebrow">Demo / Report console</p>
    <div class="heading-row">
      <h2>View counts by type</h2>
      <span class="summary-line" id="summary-line" aria-live="polite">Reading the model...</span>
    </div>

    <p class="notice notice--danger" id="error" role="alert" hidden></p>

    <div class="metrics" role="region" aria-label="Summary metrics">
      <div class="metric"><p class="metric__k">Views</p><p class="metric__v" id="metric-views">0</p></div>
      <div class="metric"><p class="metric__k">View templates</p><p class="metric__v" id="metric-templates">0</p></div>
      <div class="metric"><p class="metric__k">View types</p><p class="metric__v" id="metric-types">0</p></div>
      <div class="metric"><p class="metric__k">Types without a template</p><p class="metric__v" id="metric-gaps">0</p></div>
    </div>

    <section class="step" aria-labelledby="step-1-title">
      <div class="step__head">
        <span class="step__num" aria-hidden="true">1</span>
        <h3 class="step__title" id="step-1-title">Read the counts</h3>
      </div>
      <p class="caption">Filtering only changes what is shown here. Nothing in the model is touched.</p>
      <div class="filter-row" role="search">
        <input class="field field--search" id="filter" type="search" placeholder="Filter view types" aria-label="Filter view types" autocomplete="off">
      </div>
      <div class="tbl-wrap" role="region" aria-label="View counts by type">
        <table class="tbl" id="counts-table">
          <colgroup>
            <col>
            <col class="c-num">
            <col class="c-num">
            <col class="c-pill">
          </colgroup>
          <thead>
            <tr>
              <th scope="col">View type</th>
              <th scope="col" class="c-num">Views</th>
              <th scope="col" class="c-num">Templates</th>
              <th scope="col">Template coverage</th>
            </tr>
          </thead>
          <tbody id="counts-body"></tbody>
        </table>
        <p class="tbl-empty" id="empty" hidden>No view type matches the filter.</p>
      </div>
    </section>

    <section class="step" aria-labelledby="step-2-title">
      <div class="step__head">
        <span class="step__num" aria-hidden="true">2</span>
        <h3 class="step__title" id="step-2-title">Share the result</h3>
      </div>
      <p class="caption">Copy summary puts a plain-text version on the clipboard. The activity log records what this window did.</p>
      <div class="progress-row">
        <progress class="progress" data-progress max="1" value="0" aria-label="Progress"></progress>
        <span class="progress-label" data-progress-label aria-live="polite"></span>
      </div>
      <pre class="log" id="log" role="log" aria-label="Activity log"></pre>
    </section>
  </div>

  <div class="tool__actions" role="toolbar" aria-label="Actions">
    <button class="btn btn--secondary" id="btn-close" type="button">Close</button>
    <button class="btn btn--secondary" id="btn-copy" type="button" disabled>Copy summary</button>
    <span class="spacer"></span>
    <button class="btn btn--primary" id="btn-refresh" type="button">Read model</button>
  </div>

  <script src="https://{{ assets_host }}/bridge.js"></script>
  <script src="https://{{ assets_host }}/tool-ui.js"></script>
  <script src="tool.js"></script>
</body>
</html>
