/* Native, bounded, interruptible UI motion. No network or runtime dependency. */
(function () {
  "use strict";
  var preference = window.matchMedia("(prefers-reduced-motion: reduce)");
  var enabled = true;
  var manualOverride = false;
  function allowed() { return enabled && (!preference.matches || manualOverride); }
  function cancelAll() { document.getAnimations().forEach(function (animation) { animation.cancel(); }); }
  function animate(element, frames, options) {
    if (!allowed() || !element || !element.animate) return null;
    element.getAnimations().forEach(function (animation) { animation.cancel(); });
    return element.animate(frames, Object.assign({duration: 280, easing: "cubic-bezier(.22,1,.36,1)"}, options || {}));
  }
  function enter(elements) {
    Array.prototype.forEach.call(elements, function (el, index) {
      animate(el, [{opacity: 0, transform: "translateY(10px)"}, {opacity: 1, transform: "translateY(0)"}], {delay: Math.min(index * 45, 220)});
    });
  }
  function toggle() {
    // System reduced motion remains the default. An explicit user click can
    // opt into this tool's motion preview without changing the OS setting.
    if (preference.matches && !manualOverride) { manualOverride = true; enabled = true; }
    else enabled = !enabled;
    if (!enabled) cancelAll();
    reflect();
  }
  function reflect() {
    document.body.dataset.motion = allowed() ? "on" : "off";
    var button = document.getElementById("btn-motion");
    document.getElementById("motion-label").textContent = preference.matches && !manualOverride ? "Preview motion" : (enabled ? "Motion on" : "Motion off");
    button.setAttribute("aria-pressed", String(allowed()));
    button.title = preference.matches && !manualOverride ? "Reduced motion is active. Click to explicitly preview animations in this tool." : "Toggle interface motion";
    if (!allowed()) cancelAll();
  }
  function preferenceChanged() { manualOverride = false; reflect(); }
  if (preference.addEventListener) preference.addEventListener("change", preferenceChanged);
  else preference.addListener(preferenceChanged);
  window.ToolMotion = {animate: animate, enter: enter, allowed: allowed, toggle: toggle};
  reflect();
})();
