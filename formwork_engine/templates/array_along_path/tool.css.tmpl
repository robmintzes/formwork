/* Tool-specific geometry; all brand values come from the generated theme. */
:root {
  --accent: var(--{{ ns }}-color-accent-default);
  --accent-soft: var(--{{ ns }}-color-accent-soft);
  --ink: var(--{{ ns }}-color-text-primary);
  --muted: var(--{{ ns }}-color-text-secondary);
  --paper: var(--{{ ns }}-color-surface-default);
  --card: var(--{{ ns }}-color-surface-card);
  --sunken: var(--{{ ns }}-color-surface-sunken);
  --line: var(--{{ ns }}-color-line-subtle);
  --line-strong: var(--{{ ns }}-color-line-strong);
  --display: var(--{{ ns }}-font-display);
  --mono: var(--{{ ns }}-font-code);
  --rail-width: 320px;
  --ease: cubic-bezier(.22,1,.36,1);
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; }
body.aap-shell { display: flex; flex-direction: column; overflow: hidden; background: var(--paper); color: var(--ink); }
button, input, summary { -webkit-tap-highlight-color: transparent; }
button { cursor: pointer; }
button:disabled { cursor: default; }
button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible, [tabindex]:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.aap-header { display: grid; grid-template-columns: minmax(0,1fr) auto 148px; align-items: center; gap: 24px; padding: 16px 28px; border-bottom: 1px solid var(--line-strong); flex-shrink: 0; }
.aap-wordmark { width: 148px; height: 54px; object-fit: contain; object-position: right; }
.aap-header-tools { display: flex; align-items: center; gap: 14px; }
.aap-motion-button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 148px; padding: 0 10px; font-size: 12px; font-weight: 500; white-space: nowrap; }
.aap-motion-button[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); }
.aap-motion-button:hover { opacity: 1; background: var(--accent-soft); border-color: var(--accent); }
.aap-motion-switch { display: block; position: relative; flex: 0 0 26px; width: 26px; height: 14px; border: 1px solid currentColor; color: var(--muted); }
.aap-motion-thumb { position: absolute; top: 2px; left: 2px; width: 8px; height: 8px; background: currentColor; transition: transform 220ms var(--ease); }
.aap-motion-button[aria-pressed="true"] .aap-motion-switch { color: var(--accent); }
.aap-motion-button[aria-pressed="true"] .aap-motion-thumb { transform: translateX(12px); }
.aap-kicker { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 0; }
.aap-status { font-family: var(--mono); font-size: 10px; color: var(--accent); }
.aap-titlebar h1 { font: 600 clamp(32px,3.5vw,46px)/1 var(--display); letter-spacing: -.025em; margin: 7px 0 0; padding: 0; border: 0; color: var(--ink); }
#main-body { display: grid; grid-template-columns: var(--rail-width) 9px minmax(0,1fr); flex: 1; min-height: 0; border-top: 1px solid var(--line); width: 100%; max-width: none; margin: 0; padding: 0; }
.aap-controls { background: var(--sunken); min-height: 0; overflow: hidden; }
.aap-control-scroll { height: 100%; overflow: auto; padding: 24px; scrollbar-width: thin; }
.aap-step { padding-bottom: 24px; margin-bottom: 22px; border-bottom: 1px solid var(--line); }
.aap-step h2 { display: flex; align-items: baseline; gap: 12px; font: 600 21px/1.1 var(--display); margin: 0 0 18px; padding: 0; border: 0; color: var(--ink); }
.aap-step-index { font: 11px var(--mono); color: var(--accent); }
.aap-mode-row { position: relative; display: flex; margin-bottom: 24px; border: 1px solid var(--line-strong); padding: 3px; isolation: isolate; }
.aap-mode-row label { flex: 1; position: relative; cursor: pointer; text-align: center; }
.aap-mode-row input { position: absolute; opacity: 0; width: 100%; height: 100%; inset: 0; margin: 0; cursor: pointer; }
.aap-mode-row input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 3px; }
.aap-mode-row label span { display: block; padding: 9px 4px; font-size: 11px; position: relative; pointer-events: none; transition: color 180ms; }
.aap-mode-indicator { position: absolute; z-index: -1; background: var(--ink); width: calc(50% - 3px); top: 3px; bottom: 3px; left: 3px; transition: transform 360ms var(--ease); }
.aap-mode-row[data-mode="count"] .aap-mode-indicator { transform: translateX(100%); }
.aap-mode-row input:checked + span { color: var(--card); }
.aap-field { margin-top: 20px; }
.aap-field > label { display: block; font-size: 11px; margin-bottom: 9px; color: var(--muted); }
.aap-slider-row { display: grid; grid-template-columns: minmax(0,1fr) 66px; gap: 16px; align-items: center; }
.aap-slider-row input[type="number"] { width: 100%; height: 34px; border: 1px solid var(--line-strong); background: var(--card); color: var(--ink); text-align: center; font: 12px var(--mono); padding: 3px; border-radius: var(--{{ ns }}-radius-control,0); }
.aap-count-range { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 10px; color: var(--muted); }
.aap-count-range[hidden] { display: none; }
.aap-count-range select { font: 11px var(--mono); color: var(--ink); background: var(--card); border: 1px solid var(--line); padding: 4px 6px; }
input[type="range"] { appearance: none; width: 100%; background: transparent; height: 28px; margin: 0; cursor: ew-resize; }
input[type="range"]::-webkit-slider-runnable-track { height: 3px; background: var(--line-strong); }
input[type="range"]::-webkit-slider-thumb { appearance: none; background: var(--accent); border: 3px solid var(--sunken); box-shadow: 0 0 0 1px var(--accent); width: 14px; height: 20px; margin-top: -8px; transition: transform 180ms var(--ease); }
input[type="range"]:active::-webkit-slider-thumb { transform: scale(1.2); }
input[type="range"]::-moz-range-track { height: 3px; background: var(--line-strong); }
input[type="range"]::-moz-range-thumb { background: var(--accent); border: 0; border-radius: 0; width: 8px; height: 16px; }
.aap-check { position: relative; display: flex; gap: 10px; align-items: center; cursor: pointer; font-size: 12px; margin: 14px 0; min-height: 22px; }
.aap-check input { position: absolute; opacity: 0; width: 22px; height: 22px; margin: 0; cursor: pointer; }
.aap-check-box { flex: 0 0 20px; width: 20px; height: 20px; border: 1px solid var(--line-strong); background: var(--card); transition: background 180ms, border-color 180ms; }
.aap-check-box svg { width: 100%; height: 100%; display: block; }
.aap-check-box polyline { fill: none; stroke: var(--card); stroke-width: 2; stroke-linecap: square; stroke-linejoin: miter; stroke-dasharray: 24; stroke-dashoffset: 24; transition: stroke-dashoffset 240ms var(--ease); }
.aap-check input:checked + .aap-check-box { background: var(--accent); border-color: var(--accent); }
.aap-check input:checked + .aap-check-box polyline { stroke-dashoffset: 0; }
.aap-check input:focus-visible + .aap-check-box { outline: 2px solid var(--accent); outline-offset: 3px; }
@media (forced-colors: active) { .aap-check-box { forced-color-adjust: none; background: Canvas; border-color: CanvasText; } .aap-check input:checked + .aap-check-box { background: Highlight; border-color: Highlight; } .aap-check-box polyline { stroke: HighlightText; } }
.aap-note, .aap-source { font-size: 11px; line-height: 1.65; color: var(--muted); margin: 14px 0 0; }
.aap-source { border-left: 2px solid var(--accent); padding-left: 12px; margin-bottom: 12px; }
.aap-step summary { display: flex; justify-content: space-between; align-items: center; cursor: pointer; list-style: none; }
.aap-step summary::-webkit-details-marker { display: none; }
.aap-step summary h2 { margin: 0; }
.aap-chevron { font: 20px var(--mono); color: var(--accent); transition: transform 260ms var(--ease); }
details[open] .aap-chevron { transform: rotate(45deg); }
.aap-seed-row { display: flex; justify-content: space-between; align-items: center; margin-top: 20px; gap: 10px; }
#seed-label { font: 10px var(--mono); color: var(--muted); }
.aap-reroll { font-size: 11px; min-height: 32px; gap: 6px; }
.aap-dice { font-size: 19px; display: inline-block; }
#pane-divider { border-left: 1px solid var(--line); border-right: 1px solid var(--line); display: flex; align-items: center; justify-content: center; cursor: col-resize; background: var(--sunken); touch-action: none; }
#pane-divider span { height: 34px; width: 2px; background: var(--line-strong); transition: background 160ms; }
#pane-divider:hover span, #pane-divider:focus span { background: var(--accent); }
.aap-preview-pane { display: flex; flex-direction: column; min-width: 0; min-height: 0; padding: 22px 26px 18px; }
.aap-preview-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
.aap-live-dot { display: inline-block; width: 6px; height: 6px; background: var(--accent); margin-right: 8px; }
.aap-preview-tools { display: flex; gap: 5px; }
.aap-icon-button { border: 0; border-radius: 0; padding: 7px 10px; background: transparent; color: var(--muted); font: 10px var(--mono); transition: background 180ms, color 180ms; }
.aap-icon-button:hover { background: var(--accent-soft); color: var(--ink); }
.aap-canvas-wrap { flex: 1; min-height: 160px; position: relative; border: 1px solid var(--line-strong); background: var(--card); overflow: hidden; cursor: grab; }
.aap-canvas-wrap.aap-panning { cursor: grabbing; }
#canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
#grid { opacity: .42; }
#world .aap-copy { stroke: var(--line-strong); stroke-width: 1; }
#world .aap-copy circle { fill: var(--accent); stroke: none; opacity: .65; }
#world .aap-copy.aap-hot, #world .aap-copy.aap-sel { stroke: var(--accent); stroke-width: 2; }
#world .aap-source-marker { stroke: var(--accent); stroke-width: 2; pointer-events: none; }
#world .aap-source-marker .aap-source-ring { fill: var(--card); stroke-dasharray: 3 3; }
#world .aap-source-marker text { fill: var(--accent); stroke: var(--card); stroke-width: 4; paint-order: stroke; font: 10px var(--mono); }
.aap-canvas-corner, .aap-grid-label { position: absolute; pointer-events: none; font: 9px var(--mono); color: var(--muted); letter-spacing: .06em; background: var(--card); padding: 5px; }
.aap-canvas-corner { top: 12px; right: 12px; }
.aap-grid-label { left: 12px; bottom: 10px; }
.aap-canvas-instructions { position: absolute; right: 14px; bottom: 10px; margin: 0; font: 9px var(--mono); color: var(--muted); background: var(--card); padding: 5px; pointer-events: none; }
.aap-inspector { position: absolute; white-space: pre-line; visibility: hidden; background: var(--card); color: var(--ink); border: 1px solid var(--accent); box-shadow: 4px 4px 0 var(--accent-soft); padding: 12px 16px; font: 10px/1.8 var(--mono); pointer-events: none; z-index: 3; }
.aap-inspector.aap-visible { visibility: visible; }
.aap-stats { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); border-top: 1px solid var(--line-strong); margin-top: 18px; padding-top: 14px; gap: 12px; }
.aap-stats span { display: block; font: 9px var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; }
.aap-stats strong { font: 500 25px/1 var(--display); color: var(--ink); }
.aap-actions { display: flex; align-items: center; gap: 24px; padding: 18px 28px; border-top: 1px solid var(--line-strong); flex-shrink: 0; background: var(--card); width: 100%; max-width: none; margin: 0; }
#action-note { flex: 1; font-size: 11px; color: var(--muted); margin: 0; }
.aap-apply { display: inline-flex; align-items: center; min-width: 200px; justify-content: space-between; gap: 14px; overflow: visible; }
.aap-apply-icon { font-size: 20px; transition: transform 280ms var(--ease); }
.aap-apply:hover:not(:disabled) .aap-apply-icon { transform: translate(3px,-3px); }
.aap-apply-count { border-left: 1px solid currentColor; padding-left: 14px; font: 12px var(--mono); }
.btn { transition: transform 150ms var(--ease), background 180ms, opacity 180ms; }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn--primary::before { transition: inset 220ms var(--ease); }
.btn--primary:hover:not(:disabled)::before { inset: -9px; }
body[data-state="submitting"] .aap-apply { opacity: .75; }
@media (max-height: 730px) and (min-width: 761px) { .aap-titlebar h1 { font-size: 36px; } .aap-header { padding-top: 10px; padding-bottom: 10px; } }
@media (max-width: 900px) { .aap-header { grid-template-columns: minmax(0,1fr) 148px; row-gap: 6px; } .aap-wordmark { grid-column: 2; grid-row: 1; } .aap-header-tools { grid-column: 1 / -1; grid-row: 2; justify-content: flex-end; } .aap-canvas-instructions { display: none; } }
@media (max-width: 760px) {
  body.aap-shell { overflow: auto; height: auto; min-height: 100%; }
  .aap-header { padding: 14px 18px 8px; column-gap: 12px; grid-template-columns: minmax(0,1fr) 116px; }
  .aap-wordmark { width: 116px; height: 44px; }
  .aap-titlebar .aap-kicker { font-size: 8px; line-height: 1.6; }
  .aap-titlebar h1 { font-size: 30px; }
  .aap-status { font-size: 9px; }
  .aap-header .aap-icon-button { padding: 4px; }
  #main-body { display: flex; flex-direction: column; flex: none; }
  #pane-divider { display: none; }
  .aap-controls { order: 2; }
  .aap-control-scroll { height: auto; padding: 24px; }
  .aap-preview-pane { order: 1; padding: 18px; min-height: 390px; border-bottom: 1px solid var(--line); }
  .aap-canvas-wrap { height: 260px; flex: none; }
  .aap-stats { gap: 8px; }
  .aap-stats strong { font-size: 21px; }
  .aap-stats span { font-size: 8px; }
  .aap-actions { position: sticky; bottom: 0; padding: 14px 18px; gap: 18px; flex-wrap: wrap; z-index: 4; }
  #action-note { order: -1; flex: 0 0 100%; }
  #btn-close { margin-left: auto; }
  .aap-apply { min-width: 195px; }
}
@media (prefers-reduced-motion: reduce) { body:not([data-motion="on"]) *, body:not([data-motion="on"]) *::before { transition: none !important; animation: none !important; } }
body[data-motion="off"] *, body[data-motion="off"] *::before { transition: none !important; animation: none !important; }
