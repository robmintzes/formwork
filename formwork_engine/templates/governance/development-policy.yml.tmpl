# Generated by the design technology foundation. Job names are the required
# status checks in .github/rulesets/main-branch-ruleset.json; keep them aligned.
name: Development Policy

on:
  pull_request:
    branches: [main, stable]
  push:
    branches: [main, stable]

permissions:
  contents: read

jobs:
  branch-policy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-python@v6
        with:
          python-version: '3.11'
      - name: Validate human-owned PR branch
        if: github.event_name == 'pull_request'
        env:
          PR_HEAD_BRANCH: ${{ github.head_ref }}
        run: python validators/check_branch_policy.py --branch "$PR_HEAD_BRANCH"

  repository-validation:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-python@v6
        with:
          python-version: '3.11'
      - name: Validate bundles, safety patterns, and toolbar specification
        run: |
          python validators/check_bundle_structure.py
          python validators/check_safety_rules.py
          python validators/validate_toolbar_spec.py
      - name: Run firm tests when present
        shell: bash
        run: |
          if [ -d tests ]; then python -m unittest discover -s tests -v; else echo "No tests/ directory."; fi
