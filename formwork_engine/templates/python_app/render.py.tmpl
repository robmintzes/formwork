"""Table loading and HTML rendering. Standard library only.

Generated by formwork_engine {{ foundation_version }}. Managed file.

The report is one portable HTML file: the stylesheet (theme.css) is embedded, and
the brand SVGs are embedded as data URIs when they are small. Nothing is fetched
from a network, and every value from the input is HTML-escaped.
"""

from __future__ import annotations

import base64
import csv
from dataclasses import dataclass
import html
from importlib import resources
import io
import json
from pathlib import Path
import re
from string import Template

from . import branding

DATA_URI_LIMIT = 256 * 1024
MIME_TYPES = {".svg": "image/svg+xml", ".png": "image/png"}
NUMBER = re.compile(r"^-?\d+(?:\.\d+)?$")
# Status text -> pill tone. Matching is case-insensitive on the whole trimmed value;
# anything not listed is "info".
TONES = {
    "success": ("approved", "complete", "completed", "done", "issued", "ok", "pass", "passed", "published", "resolved"),
    "warning": ("draft", "hold", "in review", "on hold", "open", "partial", "pending", "review", "warning"),
    "danger": ("blocked", "canceled", "error", "fail", "failed", "overdue", "rejected", "void"),
}

PAGE = Template(
    """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="generator" content="$generator">
<title>$title - $display_name</title>
<style>
$css
</style>
</head>
<body>
<header class="masthead">
  <div>
    <div class="masthead__eyebrow">Table report</div>
    <div>$display_name</div>
  </div>
  <img src="$wordmark" alt="$logo_alt">
</header>
<main>
  <p class="label">Source: <span class="source">$source_name</span></p>
  <h1>$title</h1>
  <section class="metrics" aria-label="Summary">
$metrics
  </section>
  <div class="table-wrap">
$table
  </div>
</main>
<footer>
  <img src="$symbol" alt="$logo_alt">
  <span>Support: <a href="$support_url">$support_url</a>. Licenses and notices: THIRD_PARTY_NOTICES.md at the workspace root.</span>
</footer>
</body>
</html>
"""
)


class ReportError(ValueError):
    """A problem with the input or the options, worded for the person running the command."""


@dataclass(frozen=True)
class Table:
    columns: list[str]
    rows: list[list[str]]


def load_table(path: Path) -> Table:
    """Read a CSV file (header row first) or a JSON file holding a list of objects."""
    suffix = path.suffix.lower()
    if suffix not in (".csv", ".json"):
        raise ReportError("{}: expected a .csv or .json file".format(path))
    try:
        with path.open(encoding="utf-8-sig", newline="") as handle:
            text = handle.read()
    except OSError as exc:
        raise ReportError("cannot read {}: {}".format(path, exc.strerror or exc)) from exc
    except UnicodeDecodeError as exc:
        raise ReportError("{} is not valid UTF-8: {}".format(path, exc)) from exc
    return table_from_csv(text, str(path)) if suffix == ".csv" else table_from_json(text, str(path))


def table_from_csv(text: str, source: str = "input") -> Table:
    records = [record for record in csv.reader(io.StringIO(text, newline="")) if any(cell.strip() for cell in record)]
    if not records:
        raise ReportError("{} has no rows".format(source))
    columns = [cell.strip() for cell in records[0]]
    if not all(columns):
        raise ReportError("{}: the header row has an empty column name".format(source))
    rows = []
    for number, record in enumerate(records[1:], start=2):
        if len(record) > len(columns):
            raise ReportError(
                "{}: record {} has {} cells but the header has {}".format(source, number, len(record), len(columns))
            )
        rows.append([cell.strip() for cell in record] + [""] * (len(columns) - len(record)))
    return Table(columns, rows)


def table_from_json(text: str, source: str = "input") -> Table:
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        raise ReportError("{}: invalid JSON at line {} column {}: {}".format(source, exc.lineno, exc.colno, exc.msg)) from exc
    if isinstance(data, dict) and isinstance(data.get("rows"), list):
        data = data["rows"]
    if not isinstance(data, list) or not data or not all(isinstance(item, dict) for item in data):
        raise ReportError(
            "{}: expected a non-empty JSON list of objects (or an object with a \"rows\" list)".format(source)
        )
    columns: list[str] = []
    for item in data:
        for key in item:
            if key not in columns:
                columns.append(key)
    return Table(columns, [[_cell(item.get(column)) for column in columns] for item in data])


def _cell(value: object) -> str:
    if value is None:
        return ""
    return value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)


def status_tone(value: str) -> str:
    key = " ".join(value.lower().split())
    for tone, words in TONES.items():
        if key in words:
            return tone
    return "info"


def _theme_css() -> str:
    return resources.files(__package__).joinpath("theme.css").read_text(encoding="utf-8")


def asset_reference(name: str, output_dir: Path | None) -> str:
    """Data URI for a small brand asset; otherwise a copy beside the report, referenced relatively."""
    data = resources.files(__package__).joinpath("assets", name).read_bytes()
    if len(data) <= DATA_URI_LIMIT:
        mime = MIME_TYPES[Path(name).suffix.lower()]
        return "data:{};base64,{}".format(mime, base64.b64encode(data).decode("ascii"))
    if output_dir is not None:
        target = output_dir / "assets" / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
    return "assets/" + name


def _metrics(table: Table, status_index: int | None, status_column: str | None) -> str:
    items = [("Rows", str(len(table.rows))), ("Columns", str(len(table.columns)))]
    if status_index is not None:
        distinct = len({row[status_index] for row in table.rows if row[status_index]})
        items.append(("Distinct " + str(status_column), str(distinct)))
    return "\n".join(
        '    <div class="metric"><div class="metric__value">{}</div><div class="metric__label">{}</div></div>'.format(
            html.escape(value), html.escape(label)
        )
        for label, value in items
    )


def _table_html(table: Table, status_index: int | None) -> str:
    numeric = [
        index != status_index
        and any(row[index] for row in table.rows)
        and all(NUMBER.match(row[index]) for row in table.rows if row[index])
        for index in range(len(table.columns))
    ]
    head = "".join(
        '<th scope="col"{}>{}</th>'.format(' class="num"' if numeric[i] else "", html.escape(name))
        for i, name in enumerate(table.columns)
    )
    body = []
    for row in table.rows:
        cells = []
        for index, value in enumerate(row):
            if index == status_index and value:
                cells.append(
                    '<td><span class="badge badge--{}">{}</span></td>'.format(status_tone(value), html.escape(value))
                )
            else:
                cells.append("<td{}>{}</td>".format(' class="num"' if numeric[index] else "", html.escape(value)))
        body.append("<tr>" + "".join(cells) + "</tr>")
    rows = "\n".join("      " + line for line in body)
    return '    <table class="report">\n      <thead><tr>{}</tr></thead>\n      <tbody>\n{}\n      </tbody>\n    </table>'.format(
        head, rows
    )


def render_report(
    table: Table,
    *,
    title: str,
    source_name: str = "input",
    status_column: str | None = None,
    output_dir: Path | None = None,
) -> str:
    """Return the complete HTML document."""
    if status_column is None:
        status_column = next((name for name in table.columns if name.lower() == "status"), None)
    elif status_column not in table.columns:
        raise ReportError("no column named {!r}; columns are: {}".format(status_column, ", ".join(table.columns)))
    status_index = table.columns.index(status_column) if status_column is not None else None
    css = _theme_css().replace("</", "<\\/")  # a stylesheet can never close its own <style> element
    return PAGE.substitute(
        generator=html.escape(branding.GENERATOR, quote=True),
        title=html.escape(title, quote=True),
        display_name=html.escape(branding.DISPLAY_NAME, quote=True),
        logo_alt=html.escape(branding.LOGO_ALT, quote=True),
        support_url=html.escape(branding.SUPPORT_URL, quote=True),
        source_name=html.escape(source_name, quote=True),
        css=css,
        wordmark=asset_reference("wordmark-inverse.svg", output_dir),
        symbol=asset_reference("symbol-light.svg", output_dir),
        metrics=_metrics(table, status_index, status_column),
        table=_table_html(table, status_index),
    )


def write_report(path: Path, content: str) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8", newline="\n")
    except OSError as exc:
        raise ReportError("cannot write {}: {}".format(path, exc.strerror or exc)) from exc
