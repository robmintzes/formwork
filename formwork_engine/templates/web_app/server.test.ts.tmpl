// Tests for server.ts (generated by formwork_engine {{ foundation_version }}). Run with `npm test`.
import assert from 'node:assert/strict';
import { readFile } from 'node:fs/promises';
import { request } from 'node:http';
import type { AddressInfo } from 'node:net';
import type { Server } from 'node:http';
import { after, before, describe, it } from 'node:test';
import { fileURLToPath } from 'node:url';

import { HOST, PUBLIC_DIR, createAppServer, resolvePublicPath } from '../server.ts';

interface Reply {
  status: number;
  headers: Record<string, string | string[] | undefined>;
  body: string;
}

let server: Server;
let port = 0;

// node:http sends the request target exactly as written, unlike fetch(), which normalizes '..' away first.
function raw(method: string, target: string, headers: Record<string, string> = {}): Promise<Reply> {
  return new Promise((resolve, reject) => {
    const req = request({ host: HOST, port, method, path: target, headers }, (res) => {
      const chunks: Buffer[] = [];
      res.on('data', (chunk: Buffer) => chunks.push(chunk));
      res.on('end', () =>
        resolve({ status: res.statusCode ?? 0, headers: res.headers, body: Buffer.concat(chunks).toString('utf8') }),
      );
    });
    req.on('error', reject);
    req.end();
  });
}

before(async () => {
  server = createAppServer();
  await new Promise<void>((resolve) => server.listen(0, HOST, resolve));
  port = (server.address() as AddressInfo).port;
});

after(async () => {
  await new Promise<void>((resolve) => server.close(() => resolve()));
});

describe('server', () => {
  it('serves the app shell with a restrictive CSP', async () => {
    const reply = await raw('GET', '/');
    assert.equal(reply.status, 200);
    assert.equal(reply.headers['content-security-policy'], "default-src 'self'");
    assert.equal(reply.headers['x-content-type-options'], 'nosniff');
    assert.match(String(reply.headers['content-type']), /^text\/html/);
    assert.match(reply.body, /<link rel="stylesheet" href="theme.css">/);
  });

  it('binds to the loopback address only', () => {
    assert.equal((server.address() as AddressInfo).address, '127.0.0.1');
  });

  it('serves stylesheet, script and brand assets with fixed content types', async () => {
    const css = await raw('GET', '/theme.css');
    assert.equal(css.status, 200);
    assert.match(String(css.headers['content-type']), /^text\/css/);
    const script = await raw('GET', '/app.js');
    assert.match(String(script.headers['content-type']), /^text\/javascript/);
    const logo = await raw('GET', '/assets/wordmark-inverse.svg');
    assert.equal(logo.status, 200);
    assert.equal(logo.headers['content-type'], 'image/svg+xml');
  });

  it('rejects path traversal', async () => {
    for (const target of ['/../package.json', '/%2e%2e/package.json', '/..%2fpackage.json', '/assets/../../server.ts', '/%2e%2e%5cpackage.json']) {
      const reply = await raw('GET', target);
      assert.equal(reply.status, 404, target);
      assert.doesNotMatch(reply.body, /"scripts"/, target);
    }
    assert.equal((await raw('GET', '/package.json')).status, 404);
    assert.equal((await raw('GET', '/.git/config')).status, 404);
    assert.equal((await raw('GET', '/%zz')).status, 404);
    assert.equal(resolvePublicPath('/../package.json'), null);
    assert.equal(resolvePublicPath('/%2e%2e/package.json'), null);
  });

  it('answers a missing file with 404 and still sends the security headers', async () => {
    const reply = await raw('GET', '/no-such-file.txt');
    assert.equal(reply.status, 404);
    assert.equal(reply.headers['x-content-type-options'], 'nosniff');
  });

  it('refuses foreign Host headers (DNS rebinding)', async () => {
    const reply = await raw('GET', '/', { Host: 'attacker.example:' + port });
    assert.equal(reply.status, 421);
    const local = await raw('GET', '/', { Host: 'localhost:' + port });
    assert.equal(local.status, 200);
  });

  it('rejects methods other than GET', async () => {
    for (const method of ['POST', 'PUT', 'DELETE', 'HEAD']) {
      const reply = await raw(method, '/');
      assert.equal(reply.status, 405, method);
      assert.equal(reply.headers['allow'], 'GET');
    }
  });
});

describe('app shell', () => {
  it('has no inline script or style, which the CSP would block', async () => {
    const page = await readFile(fileURLToPath(new URL('../public/index.html', import.meta.url)), 'utf8');
    assert.doesNotMatch(page, /<style/i);
    assert.doesNotMatch(page, /\sstyle\s*=/i);
    assert.doesNotMatch(page, /\son[a-z]+\s*=/i);
    assert.doesNotMatch(page, /<script(?![^>]*\ssrc=)/i);
    assert.ok(PUBLIC_DIR.endsWith('public'));
  });
});
