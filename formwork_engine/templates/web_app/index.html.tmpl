<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="generator" content="formwork_engine {{ foundation_version }}">
<title>{{ title }}</title>
<link rel="stylesheet" href="theme.css">
<script type="module" src="app.js"></script>
</head>
<body>
<header class="masthead">
  <div>
    <div class="masthead__eyebrow">Web app</div>
    <div>{{ display_name }}</div>
  </div>
  <img src="assets/wordmark-inverse.svg" alt="{{ logo_alt }}">
</header>
<main>
  <p class="label">Starter</p>
  <h1>Hello, {{ short_name }}</h1>
  <p class="lede">A dependency-free web starter. Replace this card with your own screens; the colors, type,
  buttons and badges all come from the firm's design tokens.</p>

  <div class="card">
    <p class="label">Check</p>
    <div class="chips" id="chips" role="group" aria-label="Scope">
      <button class="chip" type="button" aria-pressed="true">Floor plans</button>
      <button class="chip" type="button" aria-pressed="false">Sections</button>
      <button class="chip" type="button" aria-pressed="false">Sheets</button>
    </div>
    <div class="actions">
      <button class="btn btn--primary" type="button" id="run">Run check</button>
      <button class="btn btn--secondary" type="button" id="reset">Reset</button>
    </div>
    <p class="status" id="status" role="status" aria-live="polite">Pick a scope, then run the check.</p>
  </div>

  <div class="card">
    <p class="label">Status badges</p>
    <span class="badge badge--info">Info</span><span class="badge badge--success">Ready</span><span class="badge badge--warning">Review</span><span class="badge badge--danger">Blocked</span>
  </div>
</main>
<footer>
  <img src="assets/symbol-light.svg" alt="{{ logo_alt }}">
  <span>Support: <a href="{{ support_url }}">{{ support_url }}</a>. Licenses and notices: THIRD_PARTY_NOTICES.md at the workspace root.</span>
</footer>
</body>
</html>
