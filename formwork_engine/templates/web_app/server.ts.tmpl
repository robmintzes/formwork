// Static file server for ./public. Generated by formwork_engine {{ foundation_version }}. Managed file.
//
// Dependency-free TypeScript for Node's built-in type stripping, so only erasable syntax is used
// (no enums, namespaces, parameter properties or decorators). Binds to 127.0.0.1 only.
import { createServer } from 'node:http';
import type { IncomingMessage, Server, ServerResponse } from 'node:http';
import type { AddressInfo } from 'node:net';
import { readFile, realpath, stat } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

export const HOST = '127.0.0.1';
export const DEFAULT_PORT = 5173;
export const PUBLIC_DIR = path.join(path.dirname(fileURLToPath(import.meta.url)), 'public');

const CONTENT_TYPES: Record<string, string> = {
  '.html': 'text/html; charset=utf-8',
  '.css': 'text/css; charset=utf-8',
  '.js': 'text/javascript; charset=utf-8',
  '.mjs': 'text/javascript; charset=utf-8',
  '.json': 'application/json; charset=utf-8',
  '.svg': 'image/svg+xml',
  '.png': 'image/png',
  '.ico': 'image/x-icon',
  '.txt': 'text/plain; charset=utf-8',
  '.ttf': 'font/ttf',
  '.otf': 'font/otf',
  '.woff2': 'font/woff2',
};

const SECURITY_HEADERS: Record<string, string> = {
  'Content-Security-Policy': "default-src 'self'",
  'X-Content-Type-Options': 'nosniff',
};

function send(res: ServerResponse, status: number, headers: Record<string, string>, body: string | Buffer): void {
  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
  res.end(body);
}

function sendText(res: ServerResponse, status: number, message: string, extra: Record<string, string> = {}): void {
  send(res, status, { 'Content-Type': 'text/plain; charset=utf-8', ...extra }, message + '\n');
}

// Map a request URL to a file path inside PUBLIC_DIR, or null when it must not be served.
export function resolvePublicPath(rawUrl: string, root: string = PUBLIC_DIR): string | null {
  const pathname = rawUrl.split(/[?#]/, 1)[0];
  let decoded: string;
  try {
    decoded = decodeURIComponent(pathname);
  } catch {
    return null;
  }
  if (!decoded.startsWith('/') || /[\0\\:]/.test(decoded)) return null; // NUL, backslash, drive or stream colon
  if (decoded.split('/').some((segment) => segment.startsWith('.'))) return null; // dot-files and '..'
  if (decoded.endsWith('/')) decoded += 'index.html';
  const target = path.resolve(root, '.' + decoded);
  return target.startsWith(root + path.sep) ? target : null;
}

// Only this machine's loopback names are accepted, so a DNS-rebinding page
// cannot read files through a hostname it controls.
function hostAllowed(req: IncomingMessage): boolean {
  const port = req.socket.localPort;
  const host = (req.headers.host ?? '').toLowerCase();
  return host === HOST + ':' + port || host === 'localhost:' + port;
}

async function handle(req: IncomingMessage, res: ServerResponse, root: string): Promise<void> {
  if (!hostAllowed(req)) {
    sendText(res, 421, 'Misdirected Request');
    return;
  }
  if (req.method !== 'GET') {
    sendText(res, 405, 'Method Not Allowed', { Allow: 'GET' });
    return;
  }
  const target = resolvePublicPath(req.url ?? '/', root);
  if (target === null) {
    sendText(res, 404, 'Not Found');
    return;
  }
  try {
    // Resolve symbolic links so a link inside public/ cannot lead outside it.
    const real = await realpath(target);
    const realRoot = await realpath(root);
    // Re-check the resolved long name: Windows 8.3 short names (ENV-SE~1) and
    // links can reach a dot-file whose requested spelling looked harmless.
    const segments = path.relative(realRoot, real).split(path.sep);
    if (
      !real.startsWith(realRoot + path.sep) ||
      segments.some((segment) => segment.startsWith('.')) ||
      !(await stat(real)).isFile()
    ) {
      sendText(res, 404, 'Not Found');
      return;
    }
    const type = CONTENT_TYPES[path.extname(real).toLowerCase()] ?? 'application/octet-stream';
    send(res, 200, { 'Content-Type': type, 'Cache-Control': 'no-cache' }, await readFile(real));
  } catch {
    sendText(res, 404, 'Not Found');
  }
}

export function createAppServer(root: string = PUBLIC_DIR): Server {
  return createServer((req, res) => {
    handle(req, res, root).catch(() => sendText(res, 500, 'Internal Server Error'));
  });
}

function portFromEnvironment(): number {
  const raw = process.env.PORT;
  if (raw === undefined || raw === '') return DEFAULT_PORT;
  const port = Number(raw);
  if (!Number.isInteger(port) || port < 0 || port > 65535) {
    throw new Error('PORT must be an integer from 0 to 65535, got ' + JSON.stringify(raw));
  }
  return port;
}

function isMainModule(): boolean {
  if (process.argv[1] === undefined) return false;
  const here = fileURLToPath(import.meta.url);
  const entry = path.resolve(process.argv[1]);
  return process.platform === 'win32' ? entry.toLowerCase() === here.toLowerCase() : entry === here;
}

// Start only when run directly (npm start), not when a test imports this module.
if (isMainModule()) {
  const server = createAppServer();
  server.listen(portFromEnvironment(), HOST, () => {
    // Report the bound port, which differs from PORT when PORT=0 asks for any free port.
    const bound = (server.address() as AddressInfo).port;
    console.log('Serving ' + PUBLIC_DIR + ' at http://' + HOST + ':' + bound + '/ (Ctrl+C to stop)');
  });
}
