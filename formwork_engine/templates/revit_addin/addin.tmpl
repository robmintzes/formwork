<?xml version="1.0" encoding="utf-8" standalone="no"?>
<RevitAddIns>
  <!--
    Generated by formwork_engine {{ foundation_version }}. Managed file: regenerate instead of editing.
    AddInId is derived from technical.workspace_id and never changes with branding.
    Assembly is relative to the folder this file is installed in; see README.md.
  -->
  <AddIn Type="Application">
    <Name>{{ name }}</Name>
    <Assembly>{{ assembly }}\{{ assembly }}.dll</Assembly>
    <AddInId>{{ addin_id }}</AddInId>
    <FullClassName>{{ root_namespace }}.App</FullClassName>
    <VendorId>{{ vendor_id }}</VendorId>
    <VendorDescription>{{ vendor_description }}</VendorDescription>
  </AddIn>
</RevitAddIns>
