<#
.SYNOPSIS
  Show the generated WPF specimen natively, or save a PNG snapshot of it.
.DESCRIPTION
  Generated by the design technology foundation (managed file). Loads Theme.xaml,
  Controls.xaml, and Specimen.xaml with this folder as the XAML base URI so the
  packaged fonts and brand images resolve offline. The FocusDemo button receives
  keyboard focus so the snapshot records the focus treatment.
.EXAMPLE
  powershell.exe -NoProfile -STA -File .\show-specimen.ps1
.EXAMPLE
  powershell.exe -NoProfile -STA -File .\show-specimen.ps1 -Snapshot .\specimen.png
#>
[CmdletBinding()]
param(
    [string]$Snapshot
)

$ErrorActionPreference = 'Stop'

if ([System.Threading.Thread]::CurrentThread.GetApartmentState() -ne [System.Threading.ApartmentState]::STA) {
    throw 'WPF requires a single-threaded apartment. Run with: powershell.exe -STA -File show-specimen.ps1'
}

Add-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase, System.Xaml

$here = Split-Path -Parent $MyInvocation.MyCommand.Path
$baseUri = New-Object System.Uri(($here.TrimEnd('\') + '\'), [System.UriKind]::Absolute)

function Read-Xaml([string]$Name) {
    $context = New-Object System.Windows.Markup.ParserContext
    $context.BaseUri = $baseUri
    $text = [System.IO.File]::ReadAllText((Join-Path $here $Name), [System.Text.Encoding]::UTF8)
    return [System.Windows.Markup.XamlReader]::Parse($text, $context)
}

$window = New-Object System.Windows.Window
$window.Resources.MergedDictionaries.Add((Read-Xaml 'Theme.xaml'))
$window.Resources.MergedDictionaries.Add((Read-Xaml 'Controls.xaml'))
$content = Read-Xaml 'Specimen.xaml'
$window.Content = $content
$window.Title = [string]$content.Tag
$window.SizeToContent = [System.Windows.SizeToContent]::WidthAndHeight
$window.ResizeMode = [System.Windows.ResizeMode]::CanMinimize
$window.WindowStartupLocation = [System.Windows.WindowStartupLocation]::CenterScreen

if ($Snapshot) {
    $target = [System.IO.Path]::GetFullPath($Snapshot)
    $window.Add_ContentRendered({
        $focusTarget = $content.FindName('FocusDemo')
        if ($focusTarget) { [void][System.Windows.Input.Keyboard]::Focus($focusTarget) }
        $save = [System.Action]{
            $width = [int][Math]::Ceiling($content.ActualWidth)
            $height = [int][Math]::Ceiling($content.ActualHeight)
            $bitmap = New-Object System.Windows.Media.Imaging.RenderTargetBitmap($width, $height, 96, 96, [System.Windows.Media.PixelFormats]::Pbgra32)
            $bitmap.Render($content)
            $encoder = New-Object System.Windows.Media.Imaging.PngBitmapEncoder
            $encoder.Frames.Add([System.Windows.Media.Imaging.BitmapFrame]::Create($bitmap))
            $stream = [System.IO.File]::Create($target)
            try { $encoder.Save($stream) } finally { $stream.Dispose() }
            Write-Output ('Snapshot written: ' + $target)
            $window.Close()
        }
        [void]$window.Dispatcher.BeginInvoke($save, [System.Windows.Threading.DispatcherPriority]::ApplicationIdle)
    })
}

[void]$window.ShowDialog()
