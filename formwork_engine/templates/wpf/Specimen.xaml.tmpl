<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Tag="{{ title }}" Width="760"
        Background="{DynamicResource {{ surface_default }}}">
  <StackPanel>
    <DockPanel Background="{DynamicResource {{ surface_inverse }}}" LastChildFill="True">
      <Image DockPanel.Dock="Right" Source="{{ wordmark_inverse }}" Height="40" Margin="16,12"
             AutomationProperties.Name="{{ logo_alt }}" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="Interface specimen" VerticalAlignment="Center" Margin="20,0"
                 Style="{DynamicResource {{ ns }}.Text.Body}" Foreground="{DynamicResource {{ text_inverse }}}"/>
    </DockPanel>

    <StackPanel Margin="20">
      <Border Style="{DynamicResource {{ ns }}.Card}">
        <StackPanel>
          <TextBlock Text="TYPE" Style="{DynamicResource {{ ns }}.Text.Label}"/>
          <TextBlock Text="{{ display_name }}" Style="{DynamicResource {{ ns }}.Text.Display}"/>
          <TextBlock Text="Section title" Style="{DynamicResource {{ ns }}.Text.Title}"/>
          <TextBlock Text="Body text sets the reading rhythm for tool dialogs, logs, and results." Style="{DynamicResource {{ ns }}.Text.Body}"/>
          <TextBlock Text="Secondary text for hints and metadata." Style="{DynamicResource {{ ns }}.Text.Small}"/>
          <TextBlock Text="0x1F views_filtered = 128" Style="{DynamicResource {{ ns }}.Text.Code}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource {{ ns }}.Card}">
        <StackPanel>
          <TextBlock Text="BUTTONS" Style="{DynamicResource {{ ns }}.Text.Label}"/>
          <WrapPanel Margin="4">
            <Button Content="{{ label_primary }}" Style="{DynamicResource {{ ns }}.Button.Primary}"/>
            <Button Content="{{ label_secondary }}" Style="{DynamicResource {{ ns }}.Button.Secondary}"/>
            <Button x:Name="FocusDemo" Content="{{ label_focus }}" Style="{DynamicResource {{ ns }}.Button.Secondary}"/>
            <Button Content="{{ label_disabled }}" IsEnabled="False" Style="{DynamicResource {{ ns }}.Button.Primary}"/>
            <Button Content="{{ label_disabled }}" IsEnabled="False" Style="{DynamicResource {{ ns }}.Button.Secondary}"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource {{ ns }}.Card}">
        <StackPanel>
          <TextBlock Text="SELECTION" Style="{DynamicResource {{ ns }}.Text.Label}"/>
          <WrapPanel Margin="0,0,0,8">
            <ToggleButton Content="Floor plans" IsChecked="True" Style="{DynamicResource {{ ns }}.Chip}"/>
            <ToggleButton Content="Sections" Style="{DynamicResource {{ ns }}.Chip}"/>
            <ToggleButton Content="Sheets" Style="{DynamicResource {{ ns }}.Chip}"/>
          </WrapPanel>
          <ListBox BorderThickness="0" Background="Transparent" SelectedIndex="1"
                   ItemContainerStyle="{DynamicResource {{ ns }}.ListItem}">
            <ListBoxItem Content="Level 01 - Floor Plan"/>
            <ListBoxItem Content="Level 02 - Floor Plan (selected)"/>
            <ListBoxItem Content="Roof - Floor Plan"/>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource {{ ns }}.Card}">
        <StackPanel>
          <TextBlock Text="STATUS BADGES" Style="{DynamicResource {{ ns }}.Text.Label}"/>
          <WrapPanel>
            <Border Style="{DynamicResource {{ ns }}.Badge.Info}"><TextBlock Text="{{ badge_info }}" Style="{DynamicResource {{ ns }}.Badge.Info.Text}"/></Border>
            <Border Style="{DynamicResource {{ ns }}.Badge.Success}"><TextBlock Text="{{ badge_success }}" Style="{DynamicResource {{ ns }}.Badge.Success.Text}"/></Border>
            <Border Style="{DynamicResource {{ ns }}.Badge.Warning}"><TextBlock Text="{{ badge_warning }}" Style="{DynamicResource {{ ns }}.Badge.Warning.Text}"/></Border>
            <Border Style="{DynamicResource {{ ns }}.Badge.Danger}"><TextBlock Text="{{ badge_danger }}" Style="{DynamicResource {{ ns }}.Badge.Danger.Text}"/></Border>
          </WrapPanel>
        </StackPanel>
      </Border>

      <DockPanel>
        <Image DockPanel.Dock="Left" Source="{{ symbol_light }}" Height="20" Margin="0,0,10,0"
               AutomationProperties.Name="{{ logo_alt }}" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{{ footer }}" Style="{DynamicResource {{ ns }}.Text.Small}" VerticalAlignment="Center"/>
      </DockPanel>
    </StackPanel>
  </StackPanel>
</Border>
