<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Result"
        Width="560"
        SizeToContent="Height"
        MaxHeight="672"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True">

  <!-- M1 compact result dialog (generated, managed). The window is transparent
       and the visible dialog is the inner frame; its 12 DIP margin is where the
       drop shadow renders. Chrome is drawn in WPF rather than through DWM
       WindowChrome. Fonts and brushes come from the kit resources that
       bootstrap.apply_theme merges into this window. -->
  <Border Margin="12" Style="{DynamicResource {{ ns }}.Window.Frame}">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.30"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" x:Name="TitlebarBorder" Style="{DynamicResource {{ ns }}.Titlebar}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TitlebarTextBlock" Grid.Column="0" Style="{DynamicResource {{ ns }}.Titlebar.Label}"
                     Text="Tool" AutomationProperties.Name="Window title"/>
          <StackPanel x:Name="UsageBadgePanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="Collapsed" Margin="12,0,0,0">
            <Path x:Name="UsageIcon" Style="{DynamicResource {{ ns }}.Usage.Icon}"/>
            <TextBlock x:Name="UsageLabel" Style="{DynamicResource {{ ns }}.Usage.Label}" Margin="4,0,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Style="{DynamicResource {{ ns }}.Titlebar.Divider}"/>
          <Image x:Name="BrandMark" Grid.Column="3" Height="20" Margin="12,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="{{ logo_alt }}"/>
          <!-- Close only: this dialog is modal, and minimizing a modal strands Revit behind it. -->
          <Button x:Name="CloseXBtn" Grid.Column="4" Style="{DynamicResource {{ ns }}.Titlebar.CloseButton}"
                  Content="&#xD7;" AutomationProperties.Name="Close window"/>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{DynamicResource {{ ns }}.Pane.Main}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock x:Name="EyebrowBlock" Grid.Row="0" Style="{DynamicResource {{ ns }}.Text.Eyebrow}"
                     Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.Name="Workflow family"/>
          <TextBlock x:Name="StatusHeadingBlock" Grid.Row="1" Style="{DynamicResource {{ ns }}.Text.Title}"
                     Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.Name="Result status"/>
          <TextBlock x:Name="SummaryBlock" Grid.Row="2" Style="{DynamicResource {{ ns }}.Text.Body}"
                     Margin="0,0,0,16" AutomationProperties.Name="Result summary"/>
          <TextBox x:Name="LogBox" Grid.Row="3" Style="{DynamicResource {{ ns }}.Output.Log}"
                   MaxHeight="260" Margin="0,0,0,16" AutomationProperties.Name="Execution log"/>

          <Border Grid.Row="4" Style="{DynamicResource {{ ns }}.Hairline}"/>

          <!-- Dismiss and secondary actions sit left or middle; the primary action is rightmost. -->
          <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyLogBtn" Grid.Column="0" Style="{DynamicResource {{ ns }}.Button.Secondary}"
                    Content="{{ label_copy_log }}" MinWidth="96" Margin="0" AutomationProperties.Name="Copy log to clipboard"/>
            <Button x:Name="CloseBtn" Grid.Column="2" Style="{DynamicResource {{ ns }}.Button.Secondary}"
                    Content="{{ label_close }}" MinWidth="96" Margin="0,0,8,0" AutomationProperties.Name="Close dialog"/>
            <Button x:Name="ActionBtn" Grid.Column="3" Style="{DynamicResource {{ ns }}.Button.Primary}"
                    Content="{{ label_continue }}" MinWidth="96" Margin="0" Visibility="Collapsed"
                    AutomationProperties.Name="Continue with result action"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
